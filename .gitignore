# =========================================================================
# MIMIC-IV & Clinical Data Privacy (PhysioNet Data Use Agreement Compliance)
# =========================================================================
# Strictly ignore all raw, interim, processed, and feedback clinical data
data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/feedback/*
!data/feedback/.gitkeep

# Ignore all CSV and compressed data files anywhere in data/
data/**/*.csv
data/**/*.pkl
*.csv.gz
*.parquet
*.feather
*.h5
*.sqlite3

# Ignore external MIMIC-IV database directories
mimic-iv*/
**/mimic-iv*/

# =========================================================================
# Model Weights & Scaler Artifacts (prevent binary merge conflicts)
# =========================================================================
*.pt
*.pth
*.onnx
*.pkl
models/rl_agent/*
!models/rl_agent/.gitkeep
models/scalers/*
!models/scalers/.gitkeep
models/encoders/*
!models/encoders/.gitkeep

# =========================================================================
# Generated Patient Reports & Benchmark Visualizations
# =========================================================================
reports/*
!reports/.gitkeep
*.png
*.jpg
*.jpeg

# =========================================================================
# Python & Virtual Environments
# =========================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

.env
.env.*
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# =========================================================================
# Testing & Code Quality
# =========================================================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# =========================================================================
# Jupyter Notebook Checkpoints
# =========================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# =========================================================================
# IDEs & System Files
# =========================================================================
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini
*.log
