{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Run CDSS Server & Dashboard",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "api.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}",
            "jinja": true,
            "justMyCode": true
        },
        {
            "name": "🏋️ Train RL Agent (Discrete CQL)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--mode",
                "train",
                "--epochs",
                "30"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "🔄 Retrain RL Agent (Feedback & Outcomes)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": [
                "--mode",
                "retrain",
                "--epochs",
                "10"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "📊 Run Model Accuracy Benchmark",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_model_accuracy.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
